{
  "config": {
    "step": {
      "user": {
        "title": "How is the fancoil connected?",
        "description": "The integration reads the unit. Writes stay off unless you turn them on in its options. RS-485 allows one master: if the heat pump or a wall panel shares this bus, put a gateway such as mbusd in front of it and connect every integration through the gateway.",
        "menu_options": {
          "network": "Network gateway (e.g. mbusd)",
          "serial": "USB / RS-485 adapter"
        }
      },
      "serial": {
        "title": "RS-485 adapter",
        "description": "Terminals A/B/GND on the I/O board, 8N1. Prefer a /dev/serial/by-id path: it survives reboots and replugging. Use a network gateway instead if anything else polls this bus.",
        "data": {
          "serial_port": "Serial port",
          "baudrate": "Baud rate",
          "slave": "Modbus address",
          "entity_prefix": "Entity ID prefix"
        },
        "data_description": {
          "slave": "Set on the unit: PRG → Networks and connections (password 20) → SETUP RS485 → Serial address. MST/SLV must be \"Slave from SPV\" and Protocol \"Modbus\".",
          "entity_prefix": "Every entity id starts with it, e.g. climate.fancoil and sensor.fancoil_room_temperature."
        }
      },
      "network": {
        "title": "Network gateway",
        "description": "A Modbus gateway on the fancoil's RS-485 bus. mbusd and most gateways speak Modbus TCP; choose RTU over TCP only for a transparent serial server.",
        "data": {
          "host": "Host",
          "port": "Port",
          "transport": "Gateway type",
          "slave": "Modbus address",
          "entity_prefix": "Entity ID prefix"
        },
        "data_description": {
          "slave": "Set on the unit: PRG → Networks and connections (password 20) → SETUP RS485 → Serial address. MST/SLV must be \"Slave from SPV\" and Protocol \"Modbus\".",
          "entity_prefix": "Every entity id starts with it, e.g. climate.fancoil and sensor.fancoil_room_temperature."
        }
      },
      "reconfigure": {
        "title": "Change the connection",
        "description": "Same unit, different link. Entity ids and history are kept.",
        "menu_options": {
          "reconfigure_network": "Network gateway (e.g. mbusd)",
          "reconfigure_serial": "USB / RS-485 adapter"
        }
      },
      "reconfigure_serial": {
        "title": "RS-485 adapter",
        "description": "Terminals A/B/GND on the I/O board, 8N1. Prefer a /dev/serial/by-id path: it survives reboots and replugging. Use a network gateway instead if anything else polls this bus.",
        "data": {
          "serial_port": "Serial port",
          "baudrate": "Baud rate",
          "slave": "Modbus address"
        },
        "data_description": {
          "slave": "Set on the unit: PRG → Networks and connections (password 20) → SETUP RS485 → Serial address. MST/SLV must be \"Slave from SPV\" and Protocol \"Modbus\"."
        }
      },
      "reconfigure_network": {
        "title": "Network gateway",
        "description": "A Modbus gateway on the fancoil's RS-485 bus. mbusd and most gateways speak Modbus TCP; choose RTU over TCP only for a transparent serial server.",
        "data": {
          "host": "Host",
          "port": "Port",
          "transport": "Gateway type",
          "slave": "Modbus address"
        },
        "data_description": {
          "slave": "Set on the unit: PRG → Networks and connections (password 20) → SETUP RS485 → Serial address. MST/SLV must be \"Slave from SPV\" and Protocol \"Modbus\"."
        }
      }
    },
    "error": {
      "cannot_connect": "No answer from the unit. Check the address and baud rate, and that the unit is powered and set to \"Slave from SPV\".",
      "not_fwecsa": "Something answered at that address, but not like an FWECSA.",
      "invalid_prefix": "Use lowercase letters, digits and underscores only.",
      "prefix_in_use": "Another fancoil already uses this prefix."
    },
    "abort": {
      "already_configured": "This fancoil is already configured.",
      "reconfigure_successful": "The connection was changed."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Fancoil options",
        "data": {
          "unavailable_after": "Unavailable after",
          "allow_writes": "Allow writes",
          "switching": "Summer/winter switching on the unit"
        },
        "data_description": {
          "unavailable_after": "How long the link may fail before entities show as unavailable. The last values are shown until then.",
          "allow_writes": "Off: read only. On: the coils and holding registers become switches, numbers and a select, and the climate entity can switch the unit and set its target. Every write is read back.",
          "switching": "Must match the unit's parameter \"Switching Summer/Winter\" (PRG → configuration menu, password 10). It decides which setpoint the climate entity writes and whether it can choose heating or cooling."
        }
      }
    }
  },
