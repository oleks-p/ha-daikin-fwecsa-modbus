  "exceptions": {
    "writes_disabled": {
      "message": "Writes are off for this fancoil. Turn on \"Allow writes\" in its options first."
    },
    "not_writable": {
      "message": "{key} cannot be written."
    },
    "out_of_range": {
      "message": "{value} is outside {minimum} to {maximum} in steps of {step} for {key}."
    },
    "rate_limited": {
      "message": "Too many writes: {key} can be written once every {interval} s, and the unit {daily} times a day."
    },
    "write_not_applied": {
      "message": "The fancoil did not apply {key}: wrote {expected}, it reads {actual}."
    },
    "write_not_applied_consent": {
      "message": "The fancoil did not apply {key}: wrote {expected}, it reads {actual}. {consent} is off; the unit may take {key} from Modbus only with it on."
    },
    "write_failed": {
      "message": "No answer from the fancoil while writing: {error}"
    },
    "write_refused": {
      "message": "The fancoil refused the write (Modbus exception {code})."
    },
    "read_failed": {
      "message": "No answer from the fancoil while reading: {error}"
    },
    "choose_entry": {
      "message": "Choose which fancoil: none or more than one is loaded."
    },
    "cannot_connect": {
      "message": "No answer from the FWECSA at {endpoint}."
    },
    "not_fwecsa": {
      "message": "Modbus address {slave} does not answer like an FWECSA."
    },
    "no_season": {
      "message": "The unit has not reported heating or cooling yet, so it is not known which setpoint to write."
    },
    "hvac_mode_unavailable": {
      "message": "{mode} is not available with the unit's summer/winter switching as set in the options."
    },
    "fan_mode_unavailable": {
      "message": "Fan speed {mode} is not available on this unit."
    }
  }
